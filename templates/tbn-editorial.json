{
  "name": "TBN editorial",
  "about": "Your face in a rounded card on a TBN cream page, graphics in a numbered panel below, dark-ink captions. From Rob's Instagram 'For Claude' saves (editorial grid talking head).",
  "max_seconds": 60,
  "width": 1080,
  "height": 1920,
  "zoom": {
    "alternate": true,
    "amount": 1.15
