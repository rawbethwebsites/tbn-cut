    "outline": 7,
    "outline_color": "#000000",
    "uppercase": true,
    "y": 0.7
  },
  "renderer": "remotion",
  "style": {
    "accent": "#EA6113",
    "ink": "#111111",
    "font": "Poppins",
    "captionSize": 58,
    "captionY": 0.88,
    "maxWords": 4,
    "progressBar": true,
    "uppercase": true,
    "graphicsAt": "panel",
